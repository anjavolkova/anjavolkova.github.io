---
// Selected work: one showcase, four tabs (js/main.js). With panel, On My
// Disk's "Full study" opens the case study in a panel over the page
// (js/panel.js) rather than going to it. After it, the "View study" pill
// that takes the pointer's place over a picture with a study. Every
// project's picture lies on the same paper, loaded with the page (not
// lazily) and decoded before it shows, so it stays put between projects.
import ViewStudy from "./ViewStudy.astro";
interface Props {
  panel?: boolean;
}
const { panel = false } = Astro.props;
---
  <section class="work" id="work" aria-label="Selected work">
    <div class="work-tabs" role="tablist" aria-label="Projects">
      <button class="work-tab" role="tab" id="tab-files" aria-controls="panel-files" aria-selected="true">Private file-sharing app</button>
      <button class="work-tab" role="tab" id="tab-pears" aria-controls="panel-pears" aria-selected="false" tabindex="-1">Open-source search engine</button>
      <button class="work-tab" role="tab" id="tab-node" aria-controls="panel-node" aria-selected="false" tabindex="-1">Node management</button>
      <button class="work-tab" role="tab" id="tab-smm" aria-controls="panel-smm" aria-selected="false" tabindex="-1">SMM design</button>
    </div>

    <!-- Private file-sharing app -->
    <article class="work-panel" role="tabpanel" id="panel-files" aria-labelledby="tab-files" tabindex="0">
      <div class="work-visual">
        <img class="work-paper" src="assets/img/work/paper.webp" alt="" width="480" height="664" decoding="sync">
        <div class="stage">
          <div class="shot shot--screen rise">
            <img loading="lazy" src="assets/img/work/omd-screen.webp" alt="On My Disk’s file manager: the knowledge base and chat history in the sidebar, files shared with me, and recent files." width="1068" height="633">
          </div>
        </div>
      </div>
      <div class="work-info">
        <div class="work-body">
          <h2 class="work-title">Making privacy visible in a local-first file manager</h2>
          <div class="work-meta-wrap">
            <dl class="work-meta">
              <div class="meta-row"><dt>role</dt><dd>Product designer</dd></div>
              <div class="meta-row"><dt>team</dt><dd>1 engineer, 1 designer</dd></div>
              <div class="meta-row"><dt>skills</dt><dd>Product, UX</dd></div>
              <div class="meta-row meta-row--half"><dt>timeline</dt><dd>2024–2025</dd></div>
              <div class="meta-row meta-row--half"><dt>client</dt><dd>Bineon</dd></div>
            </dl>
          </div>
          <div class="work-desc">
            <p>Most file tools, and most AI assistants, send your files to a data center. On My Disk doesn’t — the files and the assistant both live on your device. The design problem was making that believable: privacy is invisible by default, so the interface had to show people where their data was at every point.</p>
          </div>
        </div>
        <div class="work-footer">
          {panel
            ? <a class="cta" href="on-my-disk" data-link="study-files" data-panel="study-panel">Full study <img loading="lazy" class="arrow" src="assets/img/icons/arrow-left.svg" alt="" width="20" height="20"></a>
            : <a class="cta" href="#" data-link="study-files">Full study <img loading="lazy" class="arrow" src="assets/img/icons/arrow-left.svg" alt="" width="20" height="20"></a>}
        </div>
      </div>
    </article>

    <!-- Open-source search engine -->
    <article class="work-panel" role="tabpanel" id="panel-pears" aria-labelledby="tab-pears" tabindex="0" hidden>
      <div class="work-visual">
        <img class="work-paper" src="assets/img/work/paper.webp" alt="" width="480" height="664" decoding="sync">
        <div class="stage">
          <div class="shot shot--screen shot--pears rise">
            <img loading="lazy" src="assets/img/work/pears-screen.webp" alt="PeARS’ search page: a search for “AI”, with a list of results." width="1068" height="633">
          </div>
        </div>
      </div>
      <div class="work-info">
        <div class="work-body">
          <h2 class="work-title">Simplifying contributing to an open-source search engine</h2>
          <div class="work-meta-wrap">
            <dl class="work-meta">
              <div class="meta-row"><dt>role</dt><dd>UX consultant, Product designer</dd></div>
              <div class="meta-row"><dt>team</dt><dd>1 designer, 1 engineer</dd></div>
              <div class="meta-row"><dt>skills</dt><dd>Product, UX</dd></div>
              <div class="meta-row meta-row--half"><dt>timeline</dt><dd>Jan–Mar 2024</dd></div>
              <div class="meta-row meta-row--half"><dt>client</dt><dd>Denotation</dd></div>
            </dl>
          </div>
          <div class="work-desc">
            <p>PeARS is an open-source, privacy-focused search engine designed for researchers and non-profits. Because it relies on users manually submitting web pages to their search engine instances, the challenge was to remove usability barriers that made contributing difficult.</p>
          </div>
        </div>
        <div class="work-footer">
          <a class="cta" href="#" data-link="study-pears">Full study <img loading="lazy" class="arrow" src="assets/img/icons/arrow-left.svg" alt="" width="20" height="20"></a>
        </div>
      </div>
    </article>

    <!-- Node management: under NDA, so its picture is the paper alone and
         there's no study to go to. -->
    <article class="work-panel" role="tabpanel" id="panel-node" aria-labelledby="tab-node" tabindex="0" hidden>
      <div class="work-visual">
        <img class="work-paper" src="assets/img/work/paper.webp" alt="" width="480" height="664" decoding="sync">
      </div>
      <div class="work-info">
        <div class="work-body">
          <h2 class="work-title">Designing the tools that keep the internet running</h2>
          <div class="work-meta-wrap">
            <dl class="work-meta">
              <div class="meta-row"><dt>role</dt><dd>Product designer</dd></div>
              <div class="meta-row"><dt>team</dt><dd>1 PM, 3 engineers, 1 designer</dd></div>
              <div class="meta-row"><dt>skills</dt><dd>Product, UX</dd></div>
              <div class="meta-row meta-row--half"><dt>timeline</dt><dd>2025–2026</dd></div>
              <div class="meta-row meta-row--half"><dt>client</dt><dd>Multinational IoT company</dd></div>
            </dl>
          </div>
          <div class="work-desc">
            <p>Network operators rely on specialised software to monitor network infrastructure, diagnose faults, and keep services online. I redesigned a legacy network management system for the first time in over a decade, making it easier to understand what’s happening across thousands of devices and resolve problems faster.</p>
          </div>
        </div>
        <div class="work-footer">
          <p class="work-note">Project under NDA</p>
        </div>
      </div>
    </article>

    <!-- SMM design -->
    <article class="work-panel" role="tabpanel" id="panel-smm" aria-labelledby="tab-smm" tabindex="0" hidden>
      <div class="work-visual">
        <img class="work-paper" src="assets/img/work/paper.webp" alt="" width="480" height="664" decoding="sync">
        <div class="stage">
          <div class="shot shot--post tilt">
            <img loading="lazy" src="assets/img/work/smm-post.webp" alt="Instagram post designed for a beauty brand: “Kaj izbereš?” with a portrait photograph." width="366" height="457">
          </div>
          <img loading="lazy" class="grain grain--smm" src="assets/img/work/grain-smm.webp" alt="" width="758" height="511">
        </div>
      </div>
      <div class="work-info">
        <div class="work-body">
          <h2 class="work-title">Creating visuals for local beauty businesses</h2>
          <div class="work-meta-wrap">
            <dl class="work-meta">
              <div class="meta-row"><dt>role</dt><dd>Graphic designer</dd></div>
              <div class="meta-row"><dt>team</dt><dd>1 Social Media Manager, 1 Designer</dd></div>
              <div class="meta-row"><dt>skills</dt><dd>Graphic design</dd></div>
              <div class="meta-row meta-row--half"><dt>timeline</dt><dd>2026</dd></div>
              <div class="meta-row meta-row--half"><dt>client</dt><dd>Local beauty businesses</dd></div>
            </dl>
          </div>
          <div class="work-desc">
            <p>I worked closely with a talented social media specialist and photographer to develop engaging social media posts tailored for our clients in the beauty industry. Together, we crafted visually stunning content that resonates with audiences.</p>
          </div>
        </div>
        <div class="work-footer">
          <a class="cta" href="#" data-link="study-smm">Full study <img loading="lazy" class="arrow" src="assets/img/icons/arrow-left.svg" alt="" width="20" height="20"></a>
        </div>
      </div>
    </article>

  </section>

<!-- With a mouse over a project's picture that has a study, this takes the
     pointer's place, and a click there opens the study (js/main.js). -->
<ViewStudy />
