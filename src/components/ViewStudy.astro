---
// "View study": with a mouse over something that opens a case study (a
// project's picture in the work section, a paper in the case studies'
// folder), this takes the pointer's place and follows it (js/main.js).
---
<span class="view-study" aria-hidden="true">
  <span class="view-study-label"><span><span>View study</span></span></span>
  <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5.83 14.17 14.17 5.83m0 0H5.83m8.34 0v8.34" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
</span>
