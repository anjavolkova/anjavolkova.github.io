---
// Contact: the booking calendar on the stipple portrait.
---
  <!-- Phones: lets the contact section ride tucked under the pinned side
       quests (see styles.css). -->
  <div class="contact-tuck">
  <section class="contact" id="contact" aria-labelledby="contact-title">
    <canvas class="stipple stipple--contact" data-src="assets/img/stipple-source.webp" data-fade-right="0.08" aria-hidden="true"></canvas>
    <!-- Phones: which card of the side-quests carousel is in view, on this
         section's stipple. -->
    <p class="quests-counter" aria-hidden="true"><span class="quests-counter-now">1</span> / <span class="quests-counter-total">5</span></p>
    <h2 class="contact-title" id="contact-title">Tell me what you’re working on</h2>
    <p class="contact-sub">I’d love to chat and collaborate with you!</p>
    <div class="booking">
      <div class="booking-embed"></div>
      
    </div>
  </section>
  </div>
