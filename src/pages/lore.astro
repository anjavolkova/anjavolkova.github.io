---
import Page from "../layouts/Page.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MessageDialog from "../components/MessageDialog.astro";
---
<Page title="Lore — Anna Volkova" description="About Anna Volkova — a folder of bits and pieces: who I am, what I love, what I don’t." bodyClass="page-lore">
<Fragment slot="head">
<script is:inline>
  // Always open at the top, even on a reload. Links to a section still go there.
  if ("scrollRestoration" in history) history.scrollRestoration = "manual";

  // Page-load intro: hide the folder until js/main.js plays it (skipped with
  // reduced motion). If the script never runs, show it after 3s anyway.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.documentElement.classList.add("intro");
    setTimeout(function () { document.documentElement.classList.add("intro-play"); }, 3000);
  }
</script>
</Fragment>

<a class="skip-link" href="#main">Skip to content</a>

<SiteHeader page="lore" />

<main id="main">

  <!-- Lore: a folder of papers. The top paper on the right moves over to the
       left when you swipe, drag or press → (← brings it back). See
       js/lore.js. Positions are Figma's, in units of the 1440px frame;
       --deal is when each paper arrives as the page loads (the pile all at
       once, then the vellum and the photo of me, so they're a surprise),
       --deal-turn the turn it starts with, and --deal-under marks the
       papers under the top of the pile. -->
  <section class="lore" id="lore" aria-labelledby="lore-title">
    <h1 class="visually-hidden" id="lore-title">About me</h1>

    <div class="lore-backdrop" aria-hidden="true">
      <canvas class="stipple stipple--lore" data-src="assets/img/stipple-source.webp"></canvas>
      <img class="lore-lettering lore-lettering--about" src="assets/img/lore/lettering-about.svg" alt="" width="1123" height="355">
      <img class="lore-lettering lore-lettering--me" src="assets/img/lore/lettering-me.svg" alt="" width="793" height="368">
    </div>

    <div class="lore-folder" tabindex="0" role="group" aria-roledescription="folder"
         aria-label="A folder of papers about me. Press the right arrow key, swipe or drag to leaf through, and the left arrow key to go back."
         aria-describedby="lore-status">
      <img class="folder-base" src="assets/img/lore/folder-1x.webp" srcset="assets/img/lore/folder-1x.webp 1x, assets/img/lore/folder.webp 2x" alt="" width="1125" height="854">
      <span class="folder-label" aria-hidden="true">lore</span>
      <img class="folder-arrow" src="assets/img/lore/arrow.webp" alt="" width="105" height="18">

      <!-- At the back of the right-hand side, never moved: the resume and the letter. -->
      <div class="sheet sheet--fixed" data-sheet="resume" style="--x: 473; --y: 9; --w: 475; --h: 730; --cx: 48; --cy: 9; --cw: 379; --ch: 552; --deal: 0; --deal-turn: 0deg; --deal-under: 1;">
        <span class="sheet-lift" aria-hidden="true"></span>
        <img class="sheet-img" src="assets/img/lore/resume-1x.webp" srcset="assets/img/lore/resume-1x.webp 1x, assets/img/lore/resume.webp 2x" alt="My resume, in a document wallet." width="475" height="730">
        <span class="sheet-hit" aria-hidden="true"></span>
      </div>
      <div class="sheet sheet--fixed" data-sheet="envelope" style="--x: 616.63; --y: 195.39; --w: 321; --h: 394.5; --cx: 0; --cy: 13.6; --cw: 304; --ch: 381; --cr: -2.57deg; --deal: 0; --deal-turn: 0deg; --deal-under: 1;">
        <span class="sheet-lift" aria-hidden="true"></span>
        <img class="sheet-img" src="assets/img/lore/envelope-1x.webp" srcset="assets/img/lore/envelope-1x.webp 1x, assets/img/lore/envelope.webp 2x" alt="A letter sealed with wax, “write to me” on the front." width="321" height="395">
        <span class="sheet-hit" aria-hidden="true"></span>
      </div>

      <!-- The papers that move, top of the pile last. --left is where each
           one lies once it's over on the left-hand side. -->
      <div class="sheet" data-sheet="things" data-label="Things I love, things I hate" style="--x: 463; --y: 3; --w: 478; --h: 694; --left: -17; --cx: 38; --cy: 7; --cw: 402; --ch: 555; --deal: 0; --deal-turn: 0deg; --deal-under: 1;">
        <span class="sheet-lift" aria-hidden="true"></span>
        <img class="sheet-img" src="assets/img/lore/things-1x.webp" srcset="assets/img/lore/things-1x.webp 1x, assets/img/lore/things.webp 2x" alt="" width="478" height="694">
        <span class="sheet-hit" aria-hidden="true"></span>
        <div class="visually-hidden">
          <h2>Things I love</h2>
          <ul><li>Affinity design suite</li><li>Live music</li><li>Muji pens</li><li>English Breakfast tea</li><li>Reading by a body of water</li></ul>
          <h2>Things I hate</h2>
          <ul><li>Matcha</li><li>Any sport that involves me throwing or catching something</li><li>Rebasing Git</li><li>Pen tool (people who can use it are wizards)</li></ul>
        </div>
      </div>
      <div class="sheet" data-sheet="receipt" data-label="My most played songs last month" style="--x: 613.83; --y: -37.32; --w: 354.2; --h: 687.5; --left: 5.83; --cx: 111.52; --cy: 7.7; --cw: 202.4; --ch: 511.5; --cr: 7.83deg; --deal: 0; --deal-turn: 0deg; --deal-under: 1;">
        <span class="sheet-lift" aria-hidden="true"></span>
        <img class="sheet-img" src="assets/img/lore/receipt-1x.webp" srcset="assets/img/lore/receipt-1x.webp 1x, assets/img/lore/receipt.webp 2x" alt="A Receiptify receipt of my most played songs last month." width="322" height="625">
        <span class="sheet-hit" aria-hidden="true"></span>
      </div>
      <div class="sheet" data-sheet="cathedral" data-label="A photo of a cloister" style="--x: 465.9; --y: 255.22; --w: 428; --h: 412; --left: 105.9; --cx: 21; --cy: 7; --cw: 359.5; --ch: 287.78; --deal: 0; --deal-turn: 0deg; --deal-under: 1;">
        <span class="sheet-lift" aria-hidden="true"></span>
        <img class="sheet-img" src="assets/img/lore/cathedral-1x.webp" srcset="assets/img/lore/cathedral-1x.webp 1x, assets/img/lore/cathedral.webp 2x" alt="A photo of a Gothic cloister garden. I’ve lived in Utrecht, NL, Antwerp, BE &amp; Yekaterinburg, RU." width="428" height="412">
        <span class="sheet-hit" aria-hidden="true"></span>
      </div>
      <div class="sheet" data-sheet="about" data-label="About the designer" style="--x: 465; --y: 18; --w: 478; --h: 694; --left: -6; --cx: 38; --cy: 7; --cw: 402; --ch: 555; --deal: 0; --deal-turn: 0deg;">
        <span class="sheet-lift" aria-hidden="true"></span>
        <img class="sheet-img" src="assets/img/lore/about-1x.webp" srcset="assets/img/lore/about-1x.webp 1x, assets/img/lore/about.webp 2x" alt="" width="478" height="694">
        <span class="sheet-hit" aria-hidden="true"></span>
        <div class="visually-hidden">
          <h2>About the designer</h2>
          <dl><dt>occupation</dt><dd>Product &amp; visual designer</dd><dt>based in</dt><dd>Ljubljana, Slovenia</dd><dt>speak</dt><dd>English, Russian, Slovene</dd><dt>education</dt><dd>Masters Data-Driven Design</dd></dl>
          <p>Hi! I’m glad to see you here. I started designing when I got bored of playing The Sims 2 and discovered Photoshop on the family computer in 2007 &amp; I haven’t looked back since.</p>
          <p>I enjoy problem solving, learning new things and bringing my ideas to life - so I’ve tried my hand at many areas of design. But what I love the most is having fun with the visuals!</p>
        </div>
      </div>
      <div class="sheet sheet--vellum" data-sheet="vellum" data-label="Anna Volkova" style="--x: 591.74; --y: 88; --w: 394; --h: 612; --left: 103.74; --cx: 48; --cy: 9; --cw: 298; --ch: 434; --deal: 1; --deal-turn: 4deg;">
        <span class="sheet-lift" aria-hidden="true"></span>
        <span class="sheet-frost" aria-hidden="true"></span>
        <img class="sheet-img" src="assets/img/lore/vellum-1x.webp" srcset="assets/img/lore/vellum-1x.webp 1x, assets/img/lore/vellum.webp 2x" alt="" width="394" height="612">
        <span class="sheet-hit" aria-hidden="true"></span>
        <p class="visually-hidden">Anna Volkova is a designer working across interface, systems, and visual design to create products that are rigorous underneath, intuitive in use, and alive with personality.</p>
      </div>
      <div class="sheet" data-sheet="photo" data-label="A photo of me" style="--x: 408; --y: -33; --w: 372.5; --h: 477.5; --left: -16; --cx: 81.52; --cy: 7; --cw: 248.57; --ch: 310.52; --cr: 11.24deg; --deal: 2; --deal-turn: -6deg;">
        <span class="sheet-lift" aria-hidden="true"></span>
        <img class="sheet-img" src="assets/img/lore/photo-1x.webp" srcset="assets/img/lore/photo-1x.webp 1x, assets/img/lore/photo.webp 2x" alt="A photo of me, paper-clipped to the folder." width="373" height="478">
        <span class="sheet-hit" aria-hidden="true"></span>
      </div>

      <!-- The cloister photo's caption, which follows the pointer like a
           tooltip, and the resume's and the letter's buttons: above all the
           papers. -->
      <p class="pill pill--caption" data-for="cathedral" aria-hidden="true">I’ve lived in Utrecht, NL, Antwerp, BE &amp; Yekaterinburg, RU</p>
      <a class="pill pill--resume" href="#" data-link="resume" data-for="resume" download style="--px: 710.5; --py: 165;">
        Download PDF
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M17.5 12.5v1c0 1.4 0 2.1-.27 2.64a2.5 2.5 0 0 1-1.1 1.09c-.53.27-1.23.27-2.63.27h-7c-1.4 0-2.1 0-2.63-.27a2.5 2.5 0 0 1-1.1-1.1C2.5 15.6 2.5 14.9 2.5 13.5v-1m11.67-4.17L10 12.5m0 0L5.83 8.33M10 12.5v-10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <button class="pill pill--inquiry" type="button" data-opens="inquiry" data-for="envelope" style="--px: 768.6; --py: 505;">
        Inquiry form
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5.83 14.17 14.17 5.83m0 0H5.83m8.34 0v8.34" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    <p class="lore-hint" aria-hidden="true">swipe to leaf through</p>
    <p class="visually-hidden" id="lore-status" role="status" aria-live="polite"></p>
  </section>

  <!-- Contact / booking -->
  <section class="contact contact--lore" id="contact" aria-labelledby="contact-title">
    <h2 class="contact-title" id="contact-title">Tell me what you’re working on</h2>
    <p class="contact-sub">I’d love to chat and collaborate with you!</p>
    <div class="booking">
      <div class="booking-embed"></div>
    </div>
  </section>
</main>

<SiteFooter />

<!-- Shown once someone has played with the stipple for 60+ seconds. -->
<MessageDialog id="nudge" title="Seems like you’ve been playing with the design of this page for 60+ seconds now..." text="so it should be safe to say it would be worth getting in touch ;)" />

<!-- The letter's "Inquiry form": the same message form, opened from the folder. -->
<MessageDialog id="inquiry" title="Write to me" text="Tell me a little about your project and I’ll get back to you." />

</Page>
