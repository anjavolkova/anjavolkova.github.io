---
import Page from "../layouts/Page.astro";
import CaseToc from "../components/CaseToc.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MessageDialog from "../components/MessageDialog.astro";
// Not indexed while the redesign is in progress (noindex).
---
<Page title="On My Disk — making privacy visible — Anna Volkova" description="On My Disk: making privacy visible in a local-first file manager. A case study by Anna Volkova, product & visual designer." noindex bodyClass="page-study" fontWeights="300;400;500;600">
<Fragment slot="head">
<script is:inline>
  // Inside the homepage's panel (js/panel.js): its scrolling stays in the
  // panel, and the way back closes the panel.
  var inPanel = /[?&]in=panel\b/.test(location.search) && window.parent !== window;
  if (inPanel) document.documentElement.classList.add("in-panel");

  // Page-load intro: hide the opening and the read until js/main.js plays
  // it (skipped with reduced motion, and in the panel, which loads before
  // it opens). If the script never runs, show it after 3s anyway.
  if (!inPanel && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.documentElement.classList.add("intro");
    setTimeout(function () { document.documentElement.classList.add("intro-play"); }, 3000);
  }
</script>
</Fragment>

<a class="skip-link" href="#main">Skip to content</a>

<!-- Case study: On My Disk, a redesign in progress (Figma: Portfolio,
     "Desktop - 3"). The halftone trees, the On My Disk screen and the
     botanical drawings are Figma's renders, shaders and all, flattened into
     pictures. -->
<main id="main" class="study">

  <!-- The way back to the work: it stays in the corner (js/study.js). -->
  <a class="cs-back" href="/#work" aria-label="All work"><span class="cs-back-arrow" aria-hidden="true"></span></a>

  <!-- The contents, at the right edge once past the opening. -->
  <CaseToc items={[
    { id: "overview", label: "Overview" },
    { id: "impact", label: "Impact" },
    { id: "problem", label: "The Problem" },
    { id: "challenge", label: "The Challenge" },
    { id: "role", label: "My Role" },
    { id: "solutions", label: "Solutions" },
    { id: "outcome", label: "Outcome" },
    { id: "next-steps", label: "Next steps" },
    { id: "see-more", label: "See more" },
  ]} />

  <!-- The opening: the trees, paper burnt over them, and the On My Disk
       screen on top (it drifts up as the page scrolls; js/study.js). -->
  <header class="cs-banner">
    <img class="cs-banner-trees" src="assets/img/on-my-disk/banner-halftone.webp" alt="" width="1440" height="552">
    <div class="cs-banner-paper"><img src="assets/img/on-my-disk/banner-paper.webp" alt="" width="576" height="1024"></div>
    <div class="cs-mockup">
      <img src="assets/img/on-my-disk/mockup-screen.webp" alt="On My Disk’s file manager: files shared with me, recent files, and the knowledge base and chat history in the sidebar." width="976" height="583">
    </div>
  </header>

  <article class="cs">
    <h1 class="cs-title cs-block">Making privacy visible in a local-first file manager</h1>

    <div class="cs-intro">
      <dl class="cs-details">
        <div class="cs-block"><dt>Role</dt><dd>Product designer</dd></div>
        <div class="cs-block"><dt>Team</dt><dd>1 engineer<br>1 designer</dd></div>
        <div class="cs-block"><dt>Skills</dt><dd>Product, UX</dd></div>
        <div class="cs-block"><dt>Timeline</dt><dd>2024–2025</dd></div>
      </dl>
      <section class="cs-overview" aria-labelledby="overview">
        <h2 class="cs-label cs-block" id="overview">Overview</h2>
        <div class="cs-overview-text">
          <p class="cs-block">Most file tools, and most AI assistants, send your files to a data center. On My Disk doesn’t — the files and the assistant both live on your device.</p>
          <p class="cs-block">The design problem was making that believable: privacy is invisible by default, so the interface had to show people where their data was at every point.</p>
        </div>
      </section>
    </div>

    <h2 class="cs-divider cs-block" id="impact"><span>Impact</span></h2>

    <!-- What changed, in two figures, on paper with the botanical drawing.
         Each rises a little under the mouse, as the question does
         (js/study.js). -->
    <div class="cs-impact">
      <div class="cs-stat cs-paper cs-block">
        <img class="cs-paper-grain" src="assets/img/on-my-disk/card-paper.webp" alt="" width="429" height="625">
        <img class="cs-stat-botanical cs-stat-botanical--right" src="assets/img/on-my-disk/impact-botanical-1.webp" alt="" width="364" height="258">
        <p class="cs-stat-figure cs-stat-figure--tight">100%</p>
        <p class="cs-stat-text">of participants correctly identified the file’s location as local in the post-redesign survey.</p>
      </div>
      <div class="cs-stat cs-paper cs-block">
        <img class="cs-paper-grain" src="assets/img/on-my-disk/card-paper.webp" alt="" width="429" height="625">
        <img class="cs-stat-botanical cs-stat-botanical--left" src="assets/img/on-my-disk/impact-botanical-2.webp" alt="" width="369" height="258">
        <p class="cs-stat-figure">2.4x</p>
        <p class="cs-stat-text">More sign-ups since rolling out the new design &amp; private AI features.</p>
      </div>
    </div>

    <hr class="cs-rule">

    <!-- Screens on paper: the placeholder for now. Each screen rises a little
         under the mouse; its paper stays put (js/study.js). -->
    <div class="cs-gallery">
      <div class="cs-frame cs-paper cs-block cs-block--media">
        <img class="cs-paper-grain" src="assets/img/on-my-disk/card-paper.webp" alt="" width="429" height="625">
        <div class="cs-shot"><img loading="lazy" src="assets/img/on-my-disk/placeholder-screen.webp" alt="On My Disk’s file manager (a placeholder for now)." width="841" height="502"></div>
      </div>
      <div class="cs-gallery-row">
        <div class="cs-frame cs-paper cs-block cs-block--media"><img class="cs-paper-grain" src="assets/img/on-my-disk/card-paper.webp" alt="" width="429" height="625"></div>
        <div class="cs-frame cs-paper cs-block cs-block--media"><img class="cs-paper-grain" src="assets/img/on-my-disk/card-paper.webp" alt="" width="429" height="625"></div>
      </div>
    </div>

    <hr class="cs-rule">

    <div class="cs-pair">
      <section aria-labelledby="problem">
        <h2 class="cs-label cs-block" id="problem">The Problem</h2>
        <p class="cs-text cs-block">When testing a previous version of the UI with three participants, every participant but one assumed their files were sitting on someone else’s server.</p>
      </section>
      <section aria-labelledby="challenge">
        <h2 class="cs-label cs-block" id="challenge">The Challenge</h2>
        <p class="cs-text cs-block">Make file storage, privacy status, and access permissions understandable at a glance, without compromising the simplicity of the interface.</p>
      </section>
    </div>

    <!-- The research question, on paper with the botanical drawing. It rises
         a little under the mouse, as the lore page's papers do (js/study.js). -->
    <div class="cs-question cs-block">
      <img class="cs-question-paper" src="assets/img/on-my-disk/card-paper.webp" alt="" width="429" height="625">
      <img class="cs-question-botanical" src="assets/img/on-my-disk/card-botanical.webp" alt="" width="745" height="231">
      <p class="cs-question-text">How do you make users trust that their files never leave their device?</p>
    </div>

    <section class="cs-role" aria-labelledby="role">
      <h2 class="cs-label cs-block" id="role">My Role</h2>
      <p class="cs-text cs-block">I was the sole product designer, responsible for end-to-end UX and UI design. Working alongside one engineer, I led the research, from defining research questions and recruiting participants to moderating sessions and analyzing findings. I developed the design system, prototyped key interactions, and delivered the final visual design.</p>
    </section>

    <h2 class="cs-divider cs-block" id="solutions"><span>Solutions</span></h2>

    <!-- Each solution: what and why, on the right or the left, then its
         screen on paper. -->
    <div class="cs-solutions">
      <section class="cs-solution cs-solution--right" aria-labelledby="solution-indicators">
        <div class="cs-solution-text">
          <h3 class="cs-solution-title cs-block" id="solution-indicators">Visual indicators for file privacy status</h3>
          <p class="cs-solution-desc cs-block">I made the distinction between public and private files visible at a glance through status indicators with color and visual cues.</p>
        </div>
        <div class="cs-frame cs-paper cs-block cs-block--media">
          <img class="cs-paper-grain" src="assets/img/on-my-disk/card-paper.webp" alt="" width="429" height="625">
          <div class="cs-shot"><img loading="lazy" src="assets/img/on-my-disk/placeholder-screen.webp" alt="On My Disk’s file manager (a placeholder for now)." width="841" height="502"></div>
        </div>
      </section>
      <section class="cs-solution" aria-labelledby="solution-onboarding">
        <div class="cs-solution-text">
          <h3 class="cs-solution-title cs-block" id="solution-onboarding">Control through transparent onboarding</h3>
          <p class="cs-solution-desc cs-block">In a research survey of 27 participants, 15 named control over their data as their most important factor when considering AI search, so an option to pick a local model or opt out during onboarding was added.</p>
        </div>
        <div class="cs-frame cs-paper cs-block cs-block--media">
          <img class="cs-paper-grain" src="assets/img/on-my-disk/card-paper.webp" alt="" width="429" height="625">
          <div class="cs-shot"><img loading="lazy" src="assets/img/on-my-disk/placeholder-screen.webp" alt="On My Disk’s file manager (a placeholder for now)." width="841" height="502"></div>
        </div>
      </section>
      <section class="cs-solution cs-solution--right" aria-labelledby="solution-search">
        <div class="cs-solution-text">
          <h3 class="cs-solution-title cs-block" id="solution-search">Natural-language search and filtering, at no cost to privacy</h3>
          <p class="cs-solution-desc cs-block">Since participants named memory reliance and confusion about directory structure as the most common issues when retrieving files, LLM search — which you can run locally — was added.</p>
        </div>
        <div class="cs-frame cs-paper cs-block cs-block--media">
          <img class="cs-paper-grain" src="assets/img/on-my-disk/card-paper.webp" alt="" width="429" height="625">
          <div class="cs-shot"><img loading="lazy" src="assets/img/on-my-disk/placeholder-screen.webp" alt="On My Disk’s file manager (a placeholder for now)." width="841" height="502"></div>
        </div>
      </section>
    </div>

    <h2 class="cs-divider cs-block" id="outcome"><span>Outcome</span></h2>

    <!-- What came of it, in three figures on paper, the botanical drawing
         running on from one sheet to the next. Each rises a little under the
         mouse, as the impact figures do (js/study.js). -->
    <div class="cs-outcome">
      <div class="cs-stat cs-paper cs-block">
        <img class="cs-paper-grain" src="assets/img/on-my-disk/card-paper.webp" alt="" width="429" height="625">
        <img class="cs-stat-botanical cs-stat-botanical--right" src="assets/img/on-my-disk/outcome-botanical-1.webp" alt="" width="282" height="276">
        <p class="cs-stat-figure">100%</p>
        <p class="cs-stat-text">Of 26 new participants correctly identified the file’s location as local in the post-redesign survey.</p>
      </div>
      <div class="cs-stat cs-paper cs-block">
        <img class="cs-paper-grain" src="assets/img/on-my-disk/card-paper.webp" alt="" width="429" height="625">
        <img class="cs-stat-botanical cs-stat-botanical--full" src="assets/img/on-my-disk/outcome-botanical-2.webp" alt="" width="312" height="276">
        <p class="cs-stat-figure">61.5%</p>
        <p class="cs-stat-text">Correctly identified a private file as private.</p>
      </div>
      <div class="cs-stat cs-paper cs-block">
        <img class="cs-paper-grain" src="assets/img/on-my-disk/card-paper.webp" alt="" width="429" height="625">
        <img class="cs-stat-botanical cs-stat-botanical--left" src="assets/img/on-my-disk/outcome-botanical-3.webp" alt="" width="143" height="276">
        <p class="cs-stat-figure">85%</p>
        <p class="cs-stat-text">Shared a file through the three-dot menu rather than the link icon button, which is more visually prominent.</p>
      </div>
    </div>

    <h2 class="cs-divider cs-block" id="next-steps"><span>Next steps</span></h2>

    <!-- What's left to do, side by side, edged as the solutions are. -->
    <div class="cs-next">
      <section class="cs-solution-text" aria-labelledby="next-gap">
        <h3 class="cs-solution-title cs-block" id="next-gap">Close the comprehension gap</h3>
        <p class="cs-solution-desc cs-block">Ten participants still misread a private file, indicating there is more work to do in communicating privacy.</p>
      </section>
      <section class="cs-solution-text" aria-labelledby="next-cues">
        <h3 class="cs-solution-title cs-block" id="next-cues">Improve visual cues</h3>
        <p class="cs-solution-desc cs-block">Most people chose to go through a longer route to share their file, rather than through a prominent ‘Link’ icon. The icon’s meaning, placement, and visibility should be investigated, with alternative designs and positions tested.</p>
      </section>
    </div>

    <h2 class="cs-divider cs-block" id="see-more"><span>See more</span></h2>

    <!-- The other case studies: a folder of papers that works as the lore
         page's does (js/lore.js), each paper with a screenshot clipped to it
         that goes along with it. Scrolling leafs through it while the
         pointer is on it and all of it is in sight. At the back, never moved, the resume and the
         letter, with their buttons. Positions are Figma's, in units of the
         folder's frame (948 of the read's 1080). -->
    <div class="cs-more cs-block cs-block--media">
      <div class="lore-folder cs-folder" tabindex="0" role="group" aria-roledescription="folder" data-scroll-leaf="over"
           aria-label="A folder of my other case studies. Press the right arrow key, swipe or drag to leaf through, and the left arrow key to go back."
           aria-describedby="more-status">
        <img class="folder-base" loading="lazy" src="assets/img/lore/folder-1x.webp" srcset="assets/img/lore/folder-1x.webp 1x, assets/img/lore/folder.webp 2x" alt="" width="1125" height="854">
        <span class="folder-label" aria-hidden="true">Case studies</span>
        <img class="folder-arrow" loading="lazy" src="assets/img/case-studies/arrow-1x.webp" srcset="assets/img/case-studies/arrow-1x.webp 1x, assets/img/case-studies/arrow.webp 2x" alt="" width="171" height="20">

        <div class="sheet sheet--fixed" data-sheet="resume" style="--x: 473; --y: 9; --w: 475; --h: 730; --cx: 48; --cy: 9; --cw: 379; --ch: 552;">
          <span class="sheet-lift" aria-hidden="true"></span>
          <img class="sheet-img" loading="lazy" src="assets/img/lore/resume-1x.webp" srcset="assets/img/lore/resume-1x.webp 1x, assets/img/lore/resume.webp 2x" alt="My resume, in a document wallet." width="475" height="730">
          <span class="sheet-hit" aria-hidden="true"></span>
        </div>
        <div class="sheet sheet--fixed" data-sheet="envelope" style="--x: 616.63; --y: 195.39; --w: 321; --h: 394.5; --cx: 0; --cy: 13.6; --cw: 304; --ch: 381; --cr: -2.57deg;">
          <span class="sheet-lift" aria-hidden="true"></span>
          <img class="sheet-img" loading="lazy" src="assets/img/lore/envelope-1x.webp" srcset="assets/img/lore/envelope-1x.webp 1x, assets/img/lore/envelope.webp 2x" alt="A letter sealed with wax, “write to me” on the front." width="321" height="395">
          <span class="sheet-hit" aria-hidden="true"></span>
        </div>

        <!-- The papers that move, top of the pile last; --left is where each
             one lies once it's over on the left-hand side. The screenshot's
             own area takes the pointer too (sheet-hit--pin). -->
        <div class="sheet" data-sheet="beauty" data-label="Visuals for local beauty businesses" style="--x: 453; --y: 32; --w: 478; --h: 694; --left: 5; --cx: 38; --cy: 7; --cw: 402; --ch: 555;">
          <span class="sheet-lift" aria-hidden="true"></span>
          <img class="sheet-img" loading="lazy" src="assets/img/case-studies/beauty-1x.webp" srcset="assets/img/case-studies/beauty-1x.webp 1x, assets/img/case-studies/beauty.webp 2x" alt="" width="478" height="694">
          <img class="sheet-pin" loading="lazy" src="assets/img/case-studies/beauty-pin-1x.webp" srcset="assets/img/case-studies/beauty-pin-1x.webp 1x, assets/img/case-studies/beauty-pin.webp 2x" alt="Social media posts for a beauty salon, paper-clipped to the paper." width="428" height="412" style="--pin-x: 63.9; --pin-y: 236.22; --pin-w: 428;">
          <span class="sheet-hit" aria-hidden="true"></span>
          <span class="sheet-hit sheet-hit--pin" aria-hidden="true" style="--cx: 84.9; --cy: 243.22; --cw: 359.5; --ch: 287.78;"></span>
          <div class="visually-hidden">
            <h3>Visuals for local beauty businesses</h3>
            <p>Designing engaging social media posts tailored for clients in the beauty industry.</p>
            <dl><dt>Role</dt><dd>Graphic designer</dd><dt>Team</dt><dd>1 Social Media Manager, 1 Designer</dd><dt>Timeline</dt><dd>2026</dd><dt>Client</dt><dd>Local beauty businesses</dd></dl>
          </div>
        </div>
        <div class="sheet" data-sheet="pears" data-label="PeARS Search Engine" style="--x: 465; --y: 10; --w: 478; --h: 694; --left: 17; --cx: 38; --cy: 7; --cw: 402; --ch: 555;">
          <span class="sheet-lift" aria-hidden="true"></span>
          <img class="sheet-img" loading="lazy" src="assets/img/case-studies/pears-1x.webp" srcset="assets/img/case-studies/pears-1x.webp 1x, assets/img/case-studies/pears.webp 2x" alt="" width="478" height="694">
          <img class="sheet-pin" loading="lazy" src="assets/img/case-studies/pears-pin-1x.webp" srcset="assets/img/case-studies/pears-pin-1x.webp 1x, assets/img/case-studies/pears-pin.webp 2x" alt="PeARS’ home page, “The people’s search engine”, paper-clipped to the paper." width="448" height="437" style="--pin-x: 1.98; --pin-y: 253.62; --pin-w: 447.5;">
          <span class="sheet-hit" aria-hidden="true"></span>
          <span class="sheet-hit sheet-hit--pin" aria-hidden="true" style="--cx: 43.76; --cy: 260.62; --cw: 359.5; --ch: 287.78; --cr: 4.14deg;"></span>
          <div class="visually-hidden">
            <h3>PeARS Search Engine</h3>
            <p>Making contributing to an open-source search engine faster &amp; simpler</p>
            <dl><dt>Role</dt><dd>UX consultant, Product designer</dd><dt>Team</dt><dd>1 designer, 1 engineer</dd><dt>Timeline</dt><dd>Jan–Mar 2024</dd><dt>Client</dt><dd>Denotation</dd></dl>
          </div>
        </div>

        <!-- The resume's and the letter's buttons: above all the papers. -->
        <a class="pill pill--resume" href="#" data-link="resume" data-for="resume" download style="--px: 710.5; --py: 165;">
          Download PDF
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M17.5 12.5v1c0 1.4 0 2.1-.27 2.64a2.5 2.5 0 0 1-1.1 1.09c-.53.27-1.23.27-2.63.27h-7c-1.4 0-2.1 0-2.63-.27a2.5 2.5 0 0 1-1.1-1.1C2.5 15.6 2.5 14.9 2.5 13.5v-1m11.67-4.17L10 12.5m0 0L5.83 8.33M10 12.5v-10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <button class="pill pill--inquiry" type="button" data-opens="inquiry" data-for="envelope" style="--px: 768.6; --py: 505;">
          Inquiry form
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5.83 14.17 14.17 5.83m0 0H5.83m8.34 0v8.34" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <p class="lore-hint" aria-hidden="true">swipe to leaf through</p>
      <p class="visually-hidden" id="more-status" role="status" aria-live="polite"></p>
    </div>
  </article>

  <!-- Contact / booking, on the stipple, which reaches up behind the
       folder. -->
  <section class="contact contact--study" id="contact" aria-labelledby="contact-title">
    <canvas class="stipple stipple--contact" data-src="assets/img/stipple-source.webp" data-fade-right="0.08" aria-hidden="true"></canvas>
    <h2 class="contact-title" id="contact-title">Tell me what you’re working on</h2>
    <p class="contact-sub">I’d love to chat and collaborate with you!</p>
    <div class="booking">
      <div class="booking-embed"></div>
    </div>
  </section>

</main>

<SiteFooter />

<!-- Shown once someone has played with the stipple for 60+ seconds. -->
<MessageDialog id="nudge" title="Seems like you’ve been playing with the design of this page for 60+ seconds now..." text="so it should be safe to say it would be worth getting in touch ;)" />

<!-- The letter's "Inquiry form": the same message form, opened from the folder. -->
<MessageDialog id="inquiry" title="Write to me" text="Tell me a little about your project and I’ll get back to you." />

</Page>
